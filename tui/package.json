{
  "name": "obsidian-agent-tui",
  "version": "0.3.0",
  "description": "Terminal UI for ObsidianAgent — built with Ink + React + TypeScript",
  "type": "module",
  "bin": {
    "obsidian-agent-tui": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsx src/index.tsx",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
