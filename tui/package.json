    "ink-text-input": "^6.0.0",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^22.15.18",
    "@types/react": "^18.3.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
